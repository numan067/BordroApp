<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f4f7f6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="14dp"
            android:text="Maaş Hesaplama 2026"
            android:textColor="#2c3e50"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dönem (Ay)"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/monthSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vergi Dilimi"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/taxSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText
            android:id="@+id/hourlyRateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Saat Ücreti"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/monthlyHoursInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Aylık Çalışma Saati"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/nightHoursInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gece Zammı (Sa)"
            android:inputType="numberDecimal|numberSigned"
            android:text="0" />

        <EditText
            android:id="@+id/overtimeHoursInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fazla Mesai (Sa)"
            android:inputType="numberDecimal|numberSigned"
            android:text="0" />

        <EditText
            android:id="@+id/nationalHolidayInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ulusal Bayram (Sa)"
            android:inputType="numberDecimal|numberSigned"
            android:text="0" />

        <EditText
            android:id="@+id/religiousHolidayInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dini Bayram (Sa)"
            android:inputType="numberDecimal|numberSigned"
            android:text="0" />

        <EditText
            android:id="@+id/officialHolidayInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Resmi Tatil Fazla Mesai (Sa)"
            android:inputType="numberDecimal|numberSigned"
            android:text="0" />

        <EditText
            android:id="@+id/besDeductionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Net BES Kesintisi (TL)"
            android:inputType="numberDecimal|numberSigned"
            android:text="0" />

        <EditText
            android:id="@+id/vakifPercentInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vakıf Kesintisi (%)"
            android:inputType="numberDecimal|numberSigned"
            android:text="0" />

        <EditText
            android:id="@+id/transportInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Yol Ücreti (Brüt)"
            android:inputType="numberDecimal|numberSigned"
            android:text="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vergi İstisnası" />

            <TextView
                android:id="@+id/exemptionResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0,00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sendika Kesintisi" />

            <TextView
                android:id="@+id/unionResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0,00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vakıf Net Tutar" />

            <TextView
                android:id="@+id/vakifResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0,00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="30 Günlük Net İkramiye" />

            <TextView
                android:id="@+id/bonusResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0,00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#6a1b9a"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Ödenecek Net Maaş"
                android:textColor="#ffffff"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/netSalaryResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0,00 TL"
                android:textColor="#ffffff"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
